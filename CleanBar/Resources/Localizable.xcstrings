    "Screen Recording" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabación de pantalla"
          }
        }
      }
    },
    "See your Mac's temperature in the menu bar. Click it for every sensor and fan, rest the pointer on one for its history, and on Fans to set their speed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la temperatura de tu Mac en la barra de menús. Haz clic en ella para ver todos los sensores y ventiladores, deja el puntero sobre uno para ver su historial y sobre Ventiladores para ajustar su velocidad."
          }
        }
      }
    },
