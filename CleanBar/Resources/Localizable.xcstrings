        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar Ajustes"
          }
        }
      }
    },
    "Close Settings so CleanBar can work as expected" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra Ajustes para que CleanBar funcione como debe"
          }
        }
      }
    },
    "Color" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color"
          }
        }
      }
    },
    "Couldn't reach GitHub. Try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con GitHub. Inténtalo más tarde."
