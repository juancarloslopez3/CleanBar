    "Developed by Juan Carlos López." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollado por Juan Carlos López."
          }
        }
      }
    },
    "Dimmed icons are behind Apple's « because the menu bar is full. Click Refresh to bring them out." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos atenuados están detrás del « de Apple porque la barra de menús está llena. Haz clic en Actualizar para sacarlos."
          }
        }
      }
    },
    "Dot" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto"
          }
        }
      }
    },
    "Double-click a profile you added to rename it. macOS still protects your Mac if it gets too hot." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en un perfil que hayas añadido para renombrarlo. macOS sigue protegiendo tu Mac si se calienta demasiado."
          }
        }
      }
    },
    "Download and Restart" : {
