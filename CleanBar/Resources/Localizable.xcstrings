    "Temperature" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        }
      }
    },
    "The CleanBar icon and your shortcut work too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono de CleanBar y tu atajo también funcionan."
          }
        }
      }
    },
    "The clock always stays in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj siempre se queda en la barra de menús."
          }
        }
      }
    },
    "The disk image doesn't contain CleanBar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de disco no contiene CleanBar."
          }
        }
      }
    },
    "The download failed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga ha fallado."
          }
        }
      }
    },
    "The downloaded app isn't a newer CleanBar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app descargada no es una versión más reciente de CleanBar."
          }
        }
      }
    },
    "The downloaded app's signature isn't valid." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma de la app descargada no es válida."
          }
        }
      }
    },
    "The fans are set to “%@” for now, so the rules are waiting." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora los ventiladores están en “%@”, así que las reglas están en espera."
          }
        }
      }
    },
    "The first time, macOS asks for your password to install CleanBar's fan helper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez, macOS te pide la contraseña para instalar el asistente de ventiladores de CleanBar."
          }
        }
      }
    },
    "The release has no disk image to download." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión no incluye una imagen de disco para descargar."
          }
        }
      }
    },
    "The rules can't change the fans until CleanBar's fan helper is installed, which takes your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas no pueden cambiar los ventiladores hasta que se instale el asistente de ventiladores de CleanBar, para lo que hace falta tu contraseña."
          }
        }
      }
    },
    "The update couldn't be unpacked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido descomprimir la actualización."
          }
        }
      }
    },
    "This profile always stays as it is. Add your own to choose each fan's speed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil siempre se queda como está. Añade uno propio para elegir la velocidad de cada ventilador."
          }
        }
      }
    },
    "This rule applies now" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla se cumple ahora"
          }
        }
      }
    },
    "This rule doesn't apply now" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla no se cumple ahora"
          }
        }
      }
    },
    "This version of macOS doesn't let CleanBar hide icons. CleanBar needs macOS 27." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de macOS no permite que CleanBar oculte iconos. CleanBar necesita macOS 27."
          }
        }
      }
    },
    "Three Dots" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres puntos"
          }
        }
      }
    },
    "Time" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora"
          }
        }
      }
    },
    "Tips" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejos"
          }
        }
      }
    },
    "To come back to these settings, open CleanBar again from Spotlight or the Applications folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para volver a estos ajustes, abre CleanBar de nuevo desde Spotlight o la carpeta Aplicaciones."
          }
        }
      }
    },
    "Turned Off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivados"
          }
        }
      }
    },
    "Type a shortcut…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un atajo…"
          }
        }
      }
    },
    "Updating CleanBar" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizando CleanBar"
          }
        }
      }
    },
    "Version %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %@"
          }
        }
      }
    },
    "When" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando"
          }
        }
      }
    },
    "When CleanBar Opens" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir CleanBar"
          }
        }
      }
    },
    "When several rules apply, the fans use the fastest of their profiles. When none does, macOS controls them. A rule on a temperature stays on until it has been a few degrees lower for 30 seconds, so the fans don't keep changing speed. A rule can't ask for things that don't go together, or for exactly what another rule asks for, so those choices are dimmed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se cumplen varias reglas, los ventiladores usan el más rápido de sus perfiles. Cuando no se cumple ninguna, los controla macOS. Una regla de temperatura sigue activa hasta que la temperatura lleva 30 segundos unos grados por debajo, para que los ventiladores no estén cambiando de velocidad todo el rato. Una regla no puede pedir cosas incompatibles, ni exactamente lo mismo que otra regla, así que esas opciones aparecen atenuadas."
          }
        }
      }
    },
    "While Menu Bar Layout is open, hidden icons only show and hide in the menu bar, where it can read and move them, and they stay until you hide them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el editor de la barra de menús está abierto, los iconos ocultos solo se muestran y se ocultan en la barra de menús, donde puede leerlos y moverlos, y se quedan hasta que los ocultes."
          }
        }
      }
    },
    "Wi-Fi" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi"
          }
        }
      }
    },
    "With only an icon, CleanBar reads the sensors every 30 seconds instead of every 5, to save CPU. Rules and the sensors list still get them as often as they need." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con solo un icono, CleanBar lee los sensores cada 30 segundos en vez de cada 5 para ahorrar CPU. Las reglas y la lista de sensores los siguen recibiendo tan a menudo como necesitan."
          }
        }
      }
    },
    "Yellow" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amarillo"
          }
        }
      }
    },
    "You have version %@. CleanBar will download the new version and restart to install it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la versión %@. CleanBar descargará la nueva versión y se reiniciará para instalarla."
          }
        }
      }
    },
    "Your shortcut works too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu atajo también funciona."
          }
        }
      }
    },
    "is >" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "es >"
          }
        }
      }
    },
    "macOS didn't let CleanBar change the fans, so macOS keeps controlling them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que CleanBar cambie los ventiladores, así que sigue controlándolos."
          }
        }
      }
    },
    "macOS didn't let CleanBar install its fan helper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que CleanBar instale su asistente de ventiladores."
          }
        }
      }
    },
    "macOS didn't let CleanBar move “%@”. Some system items, like the clock and Control Center, can't be moved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que CleanBar mueva «%@». Algunos elementos del sistema, como el reloj y el Centro de control, no se pueden mover."
          }
        }
      }
    },
    "macOS didn't let CleanBar remove its fan helper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que CleanBar elimine su asistente de ventiladores."
          }
        }
      }
    },
    "macOS doesn't let CleanBar hide “%@”. Of macOS's own icons, CleanBar can hide Wi-Fi, Bluetooth, Battery, Sound, Display, Keyboard Brightness, Screen Mirroring and Control Center." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no deja que CleanBar oculte «%@». De los iconos propios de macOS, CleanBar puede ocultar Wi‑Fi, Bluetooth, Batería, Sonido, Pantalla, Brillo del teclado, Duplicación de pantalla y Centro de control."
          }
        }
      }
    },
    "macOS needs you to allow CleanBar in Login Items." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS necesita que permitas CleanBar en Ítems de inicio."
          }
        }
      }
    },
    "macOS says the Mac is too hot and is slowing it down to cool off (thermal state Serious or Critical). It's not a set temperature, and it usually comes on after the Mac has been hot for a while." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS indica que el Mac está demasiado caliente y lo está ralentizando para enfriarlo (estado térmico Serio o Crítico). No es una temperatura fija y suele activarse cuando el Mac lleva un rato caliente."
          }
        }
      }
    },
    "macOS system item" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemento del sistema macOS"
          }
        }
      }
    },
    "second" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "segundo"
          }
        }
      }
    },
    "seconds" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "segundos"
          }
        }
      }
    },
    "“%@” isn't in the menu bar right now, so it can't be moved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no está en la barra de menús ahora mismo, así que no se puede mover."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
