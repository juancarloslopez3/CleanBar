      }
    },
    "On Battery" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con batería"
          }
        }
      }
    },
    "Only administrators can change the fans, so CleanBar uses a small helper for it. It's installed with your password the first time you change them, and runs only while you've set a speed. When CleanBar quits, macOS takes over the fans again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los administradores pueden cambiar los ventiladores, así que CleanBar usa un pequeño asistente para ello. Se instala con tu contraseña la primera vez que los cambias y solo se ejecuta mientras tengas una velocidad ajustada. Al salir de CleanBar, macOS vuelve a encargarse de los ventiladores."
          }
        }
      }
    },
    "Open CleanBar at login" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
