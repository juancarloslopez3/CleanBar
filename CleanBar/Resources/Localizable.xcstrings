        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app"
          }
        }
      }
    },
    "Another app is setting the speed of the fans. Turn that off in that app for CleanBar to take over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está ajustando la velocidad de los ventiladores. Desactívalo en esa app para que CleanBar se encargue."
          }
        }
      }
    },
    "Any Sensor" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier sensor"
          }
        }
      }
    },
    "Any State" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier estado"
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspecto"
          }
        }
      }
    },
    "Apps hide as a whole, so an app's icons move together. macOS's own icons hide one by one, except the clock." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps se ocultan enteras, así que los iconos de una app se mueven juntos. Los iconos propios de macOS se ocultan uno a uno, salvo el reloj."
          }
        }
      }
    },
    "Arrow" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha"
          }
        }
      }
    },
    "Automatic" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático"
          }
        }
      }
    },
    "Automatic Rules" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reglas automáticas"
          }
        }
      }
    },
    "Automatic follows the rules below. To change what the fans do just for now, click the temperature in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue las reglas de abajo. Para cambiar lo que hacen los ventiladores solo por ahora, haz clic en la temperatura de la barra de menús."
          }
        }
      }
    },
    "Battery" : {
      "localizations" : {
