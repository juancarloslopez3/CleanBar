        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No instalado"
          }
        }
      }
    },
    "Not allowed in the menu bar, under System Settings → Menu Bar" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No permitidos en la barra de menús, en Ajustes del Sistema → Barra de menús"
          }
