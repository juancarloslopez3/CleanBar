    "The clock always stays in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj siempre se queda en la barra de menús."
          }
        }
      }
    },
    "This version of macOS doesn't let CleanBar hide icons. CleanBar needs macOS 27." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
